# Discord application credentials
DISCORD_TOKEN= ${{ secrets.BOT_TOKEN }}
DISCORD_CLIENT_ID= ${{ secrets.BOT_CLIENT_ID }}

# Optional: register commands only in one development server.
# Leave blank to register globally.
DISCORD_GUILD_ID= ${{ secrets.SERVER_ID }}

# Fusion verification Edge Function URL, e.g. https://PROJECT.supabase.co/functions/v1/discord-link
FUSION_API_BASE_URL= ${{ secrets.API_BASE_URL }}

# Shared secret configured as a Supabase Edge Function secret. Never commit the real value.
FUSION_BOT_API_SECRET= ${{ secrets.API_SECRET }}

# Keep false until the authenticated in-game Link Discord screen is implemented and deployed.
FUSION_LINKING_ENABLED=false

# Optional Discord role ID assigned after the backend confirms an account link.
FUSION_VERIFIED_ROLE_ID= ${{ secrets.VERIFIED_ROLE_ID }}

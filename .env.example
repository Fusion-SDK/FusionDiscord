# Set real credentials in your bot host's secret manager. Do not commit live values.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Supabase Edge Function endpoint and private bot-to-panel secret.
FUSION_PANEL_API_URL=
FUSION_BOT_API_SECRET=

# Account linking is hard-disabled in code until authenticated in-game linking is shipped.
FUSION_LINKING_ENABLED=false

# Security monitors are opt-in and alert-only.
FUSION_ANTI_RAID_MONITOR=false
FUSION_JOIN_GATE_MONITOR=false
FUSION_ANTI_NUKE_MONITOR=false
FUSION_AUTOMOD_MONITOR=false

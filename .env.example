# Discord application credentials (set real values in your bot host's secret manager)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register commands only in one development server; blank means global.
DISCORD_GUILD_ID=

# Fusion account-linking Edge Function URL.
FUSION_API_BASE_URL=

# Fusion panel-admin Edge Function URL, e.g. https://PROJECT.supabase.co/functions/v1/panel-admin
FUSION_PANEL_API_URL=

# Shared secret configured in both Supabase Edge Functions and the bot host.
# Never commit the real value.
FUSION_BOT_API_SECRET=

# Keep false until the authenticated in-game Link Discord screen is implemented and deployed.
FUSION_LINKING_ENABLED=false

# Set true to enable monitor-only anti-raid join-spike detection. Requires Server Members Intent.\nFUSION_ANTI_RAID_MONITOR=false\n\n# Legacy fallback only; the creator panel's verification role setting takes precedence.
FUSION_VERIFIED_ROLE_ID=

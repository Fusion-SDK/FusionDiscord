# Discord application credentials (set real values in your bot host's secret manager)
DISCORD_TOKEN= ${{ secrets.BOT_TOKEN }}
DISCORD_CLIENT_ID= ${{ secrets.BOT_CLIENT_ID }}
DISCORD_GUILD_ID= ${{ secrets.SERVER_ID }}

FUSION_API_BASE_URL= ${{ secrets.API_BASE_URL }}
FUSION_PANEL_API_URL= ${{ secrets.PANEL_API_URL }}
FUSION_BOT_API_SECRET= ${{ secrets.API_SECRET }}

# Keep account linking disabled until the authenticated in-game UI is shipped.
FUSION_LINKING_ENABLED=false

# Security monitors are opt-in and monitor-only in this release.
# Anti-raid and join-gate require Server Members Intent.
FUSION_ANTI_RAID_MONITOR=false
FUSION_JOIN_GATE_MONITOR=false

# Anti-nuke requires the bot to have View Audit Log for attribution in a future enforcement release.
FUSION_ANTI_NUKE_MONITOR=false

# AutoMod requires Message Content Intent.
FUSION_AUTOMOD_MONITOR=false

FUSION_VERIFIED_ROLE_ID= ${{ secrets.VERIFIED_ROLE_ID }}
